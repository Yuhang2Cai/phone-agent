+# Task7 结果汇总：读取实际JUnit、Maestro状态和API断言，条件跳过独立计数，不公开敏感调试命令。
+$ErrorActionPreference='Stop'
+$root='C:/fdz-build'
+$public="$root/docs/verification/task7-evidence"
+$runs=@()
+foreach($file in (Get-ChildItem $public -Recurse -Filter 'result.json' -File | Where-Object {$_.Directory.Name -like 'maestro-*'})) {
+ $result=Get-Content $file.FullName -Raw | ConvertFrom-Json
+ $label=$file.Directory.Name.Substring('maestro-'.Length)
+ $commands=Get-ChildItem "$root/.runtime/task7/maestro-$label" -Recurse -File -Filter 'commands.json' | Select-Object -First 1
+ $counts=@{}
+ if($commands) {
+    # 结构化调试JSON只读取metadata.status，不复制evaluatedCommand中的真实口令。
+    foreach($command in (Get-Content $commands.FullName -Raw | ConvertFrom-Json)) {
+       $status=[string]$command.metadata.status
+       if(!$counts.ContainsKey($status)) {$counts[$status]=0}
+       $counts[$status]++
+    }
+ }
+ $runs+=@{label=$label;flow=$result.flow;exitCode=$result.exitCode;apkSha256=$result.apkSha256;startedAt=$result.startedAt;finishedAt=$result.finishedAt;commandsByStatus=$counts}
+}
+$checks=@(Get-Content "$public/api-checks.json" -Raw | ConvertFrom-Json)
+$summary=@{capturedAt=(Get-Date -Format o);maestroRuns=$runs;maestroRunCount=$runs.Count;maestroExit0=@($runs | Where-Object {$_.exitCode -eq 0}).Count;maestroNonzero=@($runs | Where-Object {$_.exitCode -ne 0}).Count;apiAssertions=$checks.Count;apiPassed=@($checks | Where-Object {$_.passed}).Count;apiFailed=@($checks | Where-Object {!$_.passed}).Count;conditionalSkippedNotPassed=$true}
+$summary | ConvertTo-Json -Depth 7 | Set-Content "$public/actual-counts.json" -Encoding utf8
+Write-Output "Task7 Maestro runs=$($runs.Count) exit0=$($summary.maestroExit0) nonzero=$($summary.maestroNonzero); API=$($checks.Count) failed=$($summary.apiFailed)"
diff --git a/C:/fdz-build/scripts/Test-Task7Health.ps1 b/C:/fdz-build/scripts/Test-Task7Health.ps1
new file mode 100644
index 0000000..68f0839
--- /dev/null
+++ b/C:/fdz-build/scripts/Test-Task7Health.ps1
@@ -0,0 +1,29 @@
+# Task7 来源健康与普通JWT实测：不输出密钥或令牌，只保存来源、PID、期限、网络和开关声明。
+param([string]$Label='release',[int]$ExpectedLifetimeSeconds=3600)
+$ErrorActionPreference='Stop'
+$root='C:/fdz-build'
+$account=Get-Content "$root/.runtime/task7/account.json" -Raw | ConvertFrom-Json
+if(!$account.username.StartsWith('task7_')) {throw '非本任务账号'}
+$body=@{username=$account.username;password=$account.password} | ConvertTo-Json
+$auth=Invoke-RestMethod -Uri 'http://127.0.0.1:8080/api/auth/login' -Method Post -ContentType 'application/json' -Body $body -NoProxy
+# JWT只解码公开期限字段，绝不修改签名/内容或保存整段令牌到公开证据。
+$part=$auth.token.Split('.')[1].Replace('-','+').Replace('_','/')
+while($part.Length%4) {$part+='='}
+$claims=[Text.Encoding]::UTF8.GetString([Convert]::FromBase64String($part)) | ConvertFrom-Json
+$lifetime=[long]$claims.exp-[long]$claims.iat
+if($lifetime -ne $ExpectedLifetimeSeconds) {throw '普通JWT期限不符合当前阶段'}
+$agent=Invoke-RestMethod 'http://127.0.0.1:8091/internal/v1/health' -NoProxy
+if($agent.entryPoint -ne 'service.app:create_app' -or $agent.sourceRoot -ne 'D:\project\-Demo-master') {throw '新Agent来源不符'}
+$processes=@()
+foreach($port in @(8080,8091)) {
+ $listener=Get-NetTCPConnection -State Listen -LocalPort $port | Select-Object -First 1
+ $process=Get-CimInstance Win32_Process -Filter "ProcessId=$($listener.OwningProcess)"
+ $expected=if($port -eq 8080) {'com.fandazi.FandaziApplication'} else {'service.app:create_app'}
+ if($process.CommandLine -notlike "*$expected*") {throw '监听者来源不符'}
+ $processes+=@{port=$port;pid=$process.ProcessId;entryPoint=$expected}
+}
+$adb='C:/Users/caid0/AppData/Local/Android/Sdk/platform-tools/adb.exe'
+$network=(& $adb -s emulator-5554 shell dumpsys connectivity | Select-String 'Active default network').Line
+if($network -match 'none') {throw '尚未恢复网络'}
+@{at=(Get-Date -Format o);ordinaryJwtSeconds=$lifetime;agent=$agent;listeners=$processes;activeDefaultNetwork=$network;task2FixturesEnabled=$false;task8FailuresEnabled=$false;sourceRunnerSha256=(Get-FileHash "$root/scripts/Start-Task7Services.ps1").Hash} | ConvertTo-Json -Depth 6 | Set-Content "$root/docs/verification/task7-evidence/health-$Label.json" -Encoding utf8
+Write-Output "Task7 $Label health verified JWT=$lifetime seconds"
diff --git a/C:/fdz-build/scripts/Verify-Task7FreezeEvidence.ps1 b/C:/fdz-build/scripts/Verify-Task7FreezeEvidence.ps1
new file mode 100644
index 0000000..cc6e995
--- /dev/null
+++ b/C:/fdz-build/scripts/Verify-Task7FreezeEvidence.ps1
@@ -0,0 +1,36 @@
+# Task7 交接门禁：核对冻结源码未漂移、原私有清单/业务保护结果、APK一致及公开文本未泄露真实密钥。
+$ErrorActionPreference='Stop'
+$root='C:/fdz-build'
+$public="$root/docs/verification/task7-evidence"
+$manifest=Get-Content "$public/source-freeze.json" -Raw | ConvertFrom-Json
+foreach($file in $manifest.files) {
+ $repo=if($file.repo -eq 'phone') {$root} else {'D:/project/-Demo-master'}
+ $path=Join-Path $repo $file.path
+ if(!(Test-Path -LiteralPath $path) -or (Get-FileHash -LiteralPath $path).Hash -ne $file.sha256) {throw "冻结后源变化：$($file.repo):$($file.path)"}
+}
+if((& git -C $root rev-parse HEAD) -ne $manifest.phoneBase -or (& git -C 'D:/project/-Demo-master' rev-parse HEAD) -ne $manifest.agentBase) {throw '冻结后HEAD变化'}
+if((& git -C $root diff --cached --name-only) -or (& git -C 'D:/project/-Demo-master' diff --cached --name-only)) {throw '索引不为空，必须核对外部暂存来源'}
+# 读取本任务及服务授权秘密只作内存精确比对，不输出值，不读取Task6或Task8账号口令。
+$secrets=@()
+foreach($role in @('account','outsider')) {$value=Get-Content "$root/.runtime/task7/$role.json" -Raw | ConvertFrom-Json;$secrets+=[string]$value.password}
+$service=Get-Content "$root/.runtime/service-secrets.json" -Raw | ConvertFrom-Json
+foreach($property in $service.PSObject.Properties) {if($property.Name -match '(secret|token|key|password)' -and $property.Value -is [string]) {$secrets+=$property.Value}}
+$scanned=0
+foreach($file in (Get-ChildItem -LiteralPath $public -Recurse -File | Where-Object {$_.Extension -in @('.json','.xml','.txt','.md','.patch','.ps1','.py')})) {
+ $text=Get-Content -LiteralPath $file.FullName -Raw
+ foreach($secret in $secrets) {if($secret.Length -gt 8 -and $text.Contains($secret)) {throw "公开文件含真实秘密：$($file.Name)"}}
+ if($text -match 'eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}') {throw "公开文件含JWT：$($file.Name)"}
+ $scanned++
+}
+$installed=Get-Content "$public/apk-installed.json" -Raw | ConvertFrom-Json
+$apk=(Get-FileHash "$root/android-app/app/build/outputs/apk/debug/app-debug.apk").Hash
+if($apk -ne $installed.apkSha256 -or $installed.apkSha256 -ne $installed.deviceSha256) {throw 'APK证据版本不同'}
+$health=Get-Content "$public/health-release.json" -Raw | ConvertFrom-Json
+if($health.ordinaryJwtSeconds -ne 3600 -or $health.activeDefaultNetwork -match 'none') {throw '环境未恢复'}
+$facts=Get-Content "$public/original-facts-after.json" -Raw | ConvertFrom-Json
+foreach($property in $facts.PSObject.Properties) {if($property.Value.before -ne $property.Value.after) {throw '原业务事实变化'}}
+$before=Get-Content "$public/protected-start.json" -Raw | ConvertFrom-Json
+$after=Get-Content "$public/protected-after.json" -Raw | ConvertFrom-Json
+if(($before | ConvertTo-Json -Depth 5 -Compress) -ne ($after | ConvertTo-Json -Depth 5 -Compress)) {throw '原私有清单变化'}
+@{verifiedAt=(Get-Date -Format o);frozenSources=$manifest.files.Count;publicTextFilesScanned=$scanned;knownSecretsMatches=0;protectedPrivateFiles=$before.Count;originalBusinessTables=@($facts.PSObject.Properties).Count;apkSha256=$apk;independentAcceptance='待控制端派发';stageOrCommit=$false} | ConvertTo-Json -Depth 4 | Set-Content "$public/handoff-gate.json" -Encoding utf8
+Write-Output "Task7 freeze/evidence gate PASS sources=$($manifest.files.Count) public=$scanned protected=$($before.Count); independent pending"
