+# Task7 Maestro 运行器：账号口令仅使用本任务私有随机账号，资源身份从真实购买证据取得。
+param([string]$Flow='group-buying-04-voucher-query.yaml',[string]$Label='query',[ValidateSet('account','outsider')][string]$Account='account',[ValidateSet('orders','order','voucher')][string]$Entry='orders')
+$ErrorActionPreference='Stop'
+$env:JAVA_HOME='C:/Users/caid0/.jdks/ms-17.0.17'
+$root='C:/fdz-build'
+$accountData=Get-Content "$root/.runtime/task7/$Account.json" -Raw | ConvertFrom-Json
+if(!$accountData.username.StartsWith('task7_')) { throw '拒绝使用非Task7隔离账号' }
+$orders=Get-Content "$root/.runtime/task7/orders.json" -Raw | ConvertFrom-Json
+$resources=Get-Content "$root/.runtime/task7/resources.json" -Raw | ConvertFrom-Json
+$raw="$root/.runtime/task7/maestro-$Label"
+$output="$root/docs/verification/task7-evidence/maestro-$Label"
+if(Test-Path "$output/result.json") { throw '本次标签已有结果，禁止覆盖首次失败' }
+New-Item -ItemType Directory -Force -Path $raw,$output | Out-Null
+# 构造断言环境只传入真实公开资源和金额；命令及工具调试树可能包含口令，不复制到公开目录。
+$arguments=@('--device','emulator-5554','test','--test-output-dir',$raw,'--debug-output',$raw,
+    '-e',"MAESTRO_USERNAME=$($accountData.username)",'-e',"MAESTRO_PASSWORD=$($accountData.password)",
+    '-e',"TASK7_ORDER_A=$($orders[0].orderId)",'-e',"TASK7_ORDER_B=$($orders[1].orderId)",'-e',"TASK7_ORDER_PENDING=$($orders[2].orderId)",
+    '-e',"TASK7_VOUCHER_A=$($orders[0].vouchers[0].publicId)",'-e',"TASK7_VOUCHER_B=$($orders[0].vouchers[1].publicId)",
+    '-e',"TASK7_VOUCHER_C=$($orders[1].vouchers[0].publicId)",'-e',"TASK7_PENDING_VOUCHER=$($orders[2].vouchers[0].publicId)",
+    '-e',"TASK6_STORE_ID=$($resources[1].storePublicId)",'-e',"TASK6_DEAL_ID=$($resources[1].public_id)",
+    '-e','TASK6_TOTAL=.*96\.47','-e','TASK6_QUANTITY=1','-e','TASK6_VOUCHER_TARGET=com.fandazi.app:id/voucher_detail_status',"$root/maestro/$Flow")
+# 登录恢复断言按显式测试入口选择目标，不改变产品导航或业务状态。
+$returnId=switch($Entry) {'orders' {'com.fandazi.app:id/orders_segments'} 'order' {'com.fandazi.app:id/group_order_detail_title'} 'voucher' {'com.fandazi.app:id/voucher_detail_info'}}
+$arguments=$arguments[0..($arguments.Length-2)]+@('-e',"TASK7_ENTRY=$Entry",'-e',"TASK7_RETURN_ID=$returnId",$arguments[-1])
+$started=Get-Date -Format o
+& 'C:/Users/caid0/.local/maestro/bin/maestro.bat' @arguments *> "$root/.runtime/task7/maestro-$Label.log"
+$code=$LASTEXITCODE
+# 仅导出显式截图和摘要；每次APK摘要绑定具体运行结果，不以YAML存在当作通过。
+Get-ChildItem -LiteralPath $raw -Recurse -File -Filter '*.png' | Where-Object {$_.FullName -match 'takeScreenshot'} | ForEach-Object {
+    $destination=Join-Path $output ([IO.Path]::GetRelativePath($raw,$_.FullName))
+    New-Item -ItemType Directory -Force -Path (Split-Path $destination) | Out-Null
+    Copy-Item -LiteralPath $_.FullName -Destination $destination
+}
+@{exitCode=$code;flow=$Flow;accountRole=$Account;startedAt=$started;finishedAt=(Get-Date -Format o);apkSha256=(Get-FileHash "$root/android-app/app/build/outputs/apk/debug/app-debug.apk").Hash;orderIds=@($orders.orderId);voucherIds=@($orders.vouchers.publicId)} | ConvertTo-Json -Depth 5 | Set-Content "$output/result.json" -Encoding utf8
+Write-Output "Task7 Maestro $Label exit=$code"
+exit $code
diff --git a/C:/fdz-build/scripts/Start-Task7Services.ps1 b/C:/fdz-build/scripts/Start-Task7Services.ps1
new file mode 100644
index 0000000..beec46f
--- /dev/null
+++ b/C:/fdz-build/scripts/Start-Task7Services.ps1
@@ -0,0 +1,53 @@
+# Task7 服务运行器：仅重启已核实的新 Agent/Spring，关闭所有开发夹具开关，不操作业务资源。
+param([ValidateSet('Spring','Agent')][string]$Service = 'Spring', [ValidateRange(1,1440)][int]$JwtExpirationMinutes = 60)
+$ErrorActionPreference = 'Stop'
+# 本地双服务和模型请求均禁用环境代理，避免将 localhost 或内部鉴权流量送到外部代理。
+$env:HTTP_PROXY=''; $env:HTTPS_PROXY=''; $env:ALL_PROXY=''; $env:NO_PROXY='*'
+$root = Split-Path -Parent $PSScriptRoot
+$port = if ($Service -eq 'Spring') { 8080 } else { 8091 }
+$expected = if ($Service -eq 'Spring') { 'com.fandazi.FandaziApplication' } else { 'service.app:create_app' }
+# 先核对监听进程职责，仅停止目标端口拥有者，禁止泛杀 Java/Python 或其他任务进程。
+$listener = Get-NetTCPConnection -State Listen -LocalPort $port -ErrorAction SilentlyContinue | Select-Object -First 1
+if ($listener) {
+    $owner = Get-CimInstance Win32_Process -Filter "ProcessId = $($listener.OwningProcess)"
+    if ($owner.CommandLine -notlike "*$expected*") { throw '目标端口拥有者不符合已批准服务，拒绝重启' }
+    Stop-Process -Id $owner.ProcessId
+    Start-Sleep -Seconds 2
+}
+$runtime = Join-Path $root '.runtime'
+if ($Service -eq 'Spring') {
+    . (Join-Path $PSScriptRoot 'Initialize-FandaziEnvironment.ps1')
+    $env:TASK2_FIXTURES_ENABLED = 'false'
+    $env:TASK8_FAILURES_ENABLED = 'false'
+    $env:SEED_ENABLED = 'false'
+    $env:SPRING_PROFILES_ACTIVE = 'default'
+    # 普通 JWT 生命周期配置用于自然过期验证，禁止使用开发故障或夹具开关；结束恢复默认六十分钟。
+    $env:JWT_EXPIRATION_MINUTES = "$JwtExpirationMinutes"
+    # 普通访问日志仅记录时间、方法、路径和状态，核实自然过期产生的真实 401，不记录令牌或请求体。
+    $env:SERVER_TOMCAT_ACCESSLOG_ENABLED = 'true'
+    $env:SERVER_TOMCAT_ACCESSLOG_DIRECTORY = (Join-Path $runtime 'task7-http-access')
+    $env:SERVER_TOMCAT_ACCESSLOG_PATTERN = '%t %m %U %s'
+    $env:SERVER_TOMCAT_ACCESSLOG_BUFFERED = 'false'
+    $env:JAVA_HOME = 'C:/Users/caid0/.jdks/ms-17.0.17'
+    $process = Start-Process -FilePath 'D:/software/IntelliJ IDEA 2025.2.4/plugins/maven/lib/maven3/bin/mvn.cmd' -ArgumentList '-q','spring-boot:run' -WorkingDirectory (Join-Path $root 'backend') -WindowStyle Hidden -PassThru -RedirectStandardOutput (Join-Path $runtime 'task7-spring.out.log') -RedirectStandardError (Join-Path $runtime 'task7-spring.err.log')
+} else {
+    # Agent 独立数据库/模型配置由其 .env 加载，不能继承 Spring 的业务 DB_URL 覆盖 dianping_intent。
+    foreach ($name in @('DB_URL','DB_USERNAME','DB_PASSWORD')) { Remove-Item -LiteralPath "Env:$name" -ErrorAction SilentlyContinue }
+    $secrets = Get-Content -LiteralPath (Join-Path $runtime 'service-secrets.json') -Raw | ConvertFrom-Json
+    $env:AGENT_INTERNAL_TOKEN = $secrets.internalToken
+    $env:AGENT_BUILD_VERSION = 'c339237-task7-working-tree'
+    $env:LANGCHAIN_TRACING_V2 = 'false'
+    $env:TASK2_FIXTURES_ENABLED = 'false'
+    $env:TASK8_FAILURES_ENABLED = 'false'
+    $process = Start-Process -FilePath 'C:/Users/caid0/anaconda3/envs/pinnT/python.exe' -ArgumentList '-m','uvicorn','service.app:create_app','--factory','--host','127.0.0.1','--port','8091' -WorkingDirectory 'D:/project/-Demo-master' -WindowStyle Hidden -PassThru -RedirectStandardOutput (Join-Path $runtime 'task7-agent.out.log') -RedirectStandardError (Join-Path $runtime 'task7-agent.err.log')
+}
+# 输出仅含进程角色与 PID，不输出密钥、账户或数据库连接字符串。
+$health = if ($Service -eq 'Spring') { 'http://127.0.0.1:8080/api/stores/cities' } else { 'http://127.0.0.1:8091/internal/v1/health' }
+# 服务进程创建不等于健康，等待实际接口，防止冷启动窗口被误算成模型/协议失败。
+$ready = $false
+for ($attempt = 0; $attempt -lt 60; $attempt++) {
+    try { $null = Invoke-RestMethod -Uri $health -NoProxy -TimeoutSec 2; $ready = $true; break }
+    catch { Start-Sleep -Seconds 1 }
+}
+if (!$ready) { throw '服务启动后未通过健康接口，请查看忽略目录运行日志' }
+[pscustomobject]@{Service=$Service;LauncherPid=$process.Id;Port=$port} | ConvertTo-Json
diff --git a/C:/fdz-build/scripts/Summarize-Task7Evidence.ps1 b/C:/fdz-build/scripts/Summarize-Task7Evidence.ps1
new file mode 100644
index 0000000..431a843
--- /dev/null
