<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/nav_graph" app:startDestination="@id/authFragment">

    <fragment android:id="@+id/authFragment" android:name="com.fandazi.app.feature.auth.AuthFragment" android:label="@string/login" />

    <fragment android:id="@+id/homeFragment" android:name="com.fandazi.app.feature.home.HomeFragment" android:label="@string/home" />

    <fragment android:id="@+id/agentChatFragment" android:name="com.fandazi.app.feature.agent.AgentChatFragment" android:label="AI 助手" />

    <fragment android:id="@+id/searchFragment" android:name="com.fandazi.app.feature.search.SearchFragment" android:label="@string/search_page" />
    <fragment android:id="@+id/merchantFragment" android:name="com.fandazi.app.feature.merchant.MerchantFragment" android:label="@string/merchant_page">
        <argument android:name="merchantId" app:argType="long" />
    </fragment>
    <fragment android:id="@+id/ordersFragment" android:name="com.fandazi.app.feature.order.OrdersFragment" android:label="@string/orders_page" />
    <fragment android:id="@+id/profileFragment" android:name="com.fandazi.app.feature.profile.ProfileFragment" android:label="@string/profile_page" />
    <fragment android:id="@+id/addressFragment" android:name="com.fandazi.app.feature.profile.AddressFragment" android:label="@string/address_title" />
    <fragment android:id="@+id/addressEditFragment" android:name="com.fandazi.app.feature.profile.AddressEditFragment" android:label="@string/address_edit_title" />
    <fragment android:id="@+id/automationSettingsFragment" android:name="com.fandazi.app.feature.profile.AutomationSettingsFragment" android:label="@string/automation_title" />
    <fragment android:id="@+id/cartFragment" android:name="com.fandazi.app.feature.order.CartFragment" android:label="@string/cart_title" />
    <fragment android:id="@+id/paymentFragment" android:name="com.fandazi.app.feature.order.PaymentFragment" android:label="@string/payment_page" />
    <fragment android:id="@+id/storeFragment" android:name="com.fandazi.app.feature.store.StoreFragment" android:label="门店详情">
        <argument android:name="storePublicId" app:argType="string" />
    </fragment>
    <fragment android:id="@+id/dealDetailFragment" android:name="com.fandazi.app.feature.deal.DealDetailFragment" android:label="团购套餐">
        <argument android:name="dealPublicId" app:argType="string" />
        <argument android:name="storePublicId" app:argType="string" />
    </fragment>
    <!-- UI-07 是套餐详情上的浮动底部弹窗；导航到支付页时自动移除该确认窗口。 -->
    <dialog android:id="@+id/dealCheckoutBottomSheetFragment" android:name="com.fandazi.app.feature.purchase.DealCheckoutBottomSheetFragment" android:label="确认购买">
        <argument android:name="dealPublicId" app:argType="string" />
        <argument android:name="storePublicId" app:argType="string" android:defaultValue="" />
        <argument android:name="quantity" app:argType="integer" />
    </dialog>
    <fragment android:id="@+id/groupBuyPaymentFragment" android:name="com.fandazi.app.feature.purchase.GroupBuyPaymentFragment" android:label="模拟支付" />
    <fragment android:id="@+id/paymentSuccessFragment" android:name="com.fandazi.app.feature.purchase.PaymentSuccessFragment" android:label="支付成功" />
    <!-- Task7 只读入口：订单和券身份从用户显式点击透传；下面原 dirty QR/售后路由不归本任务。 -->
    <fragment android:id="@+id/groupOrderDetailFragment" android:name="com.fandazi.app.feature.voucher.GroupOrderDetailFragment" android:label="订单详情">
        <argument android:name="orderId" app:argType="string" />
    </fragment>
    <fragment android:id="@+id/voucherDetailFragment" android:name="com.fandazi.app.feature.voucher.VoucherDetailFragment" android:label="团购券详情">
        <argument android:name="voucherId" app:argType="string" />
    </fragment>
    <!-- 售后页面使用公开订单或券 ID，绝不把后端内部主键放入导航参数。 -->
    <fragment android:id="@+id/refundRequestFragment" android:name="com.fandazi.app.feature.refund.RefundRequestFragment" android:label="申请退款">
        <argument android:name="voucherId" app:argType="string" />
    </fragment>
    <fragment android:id="@+id/refundProgressFragment" android:name="com.fandazi.app.feature.refund.RefundProgressFragment" android:label="退款进度">
        <argument android:name="requestId" app:argType="string" />
        <argument android:name="dealTitle" app:argType="string" android:defaultValue="" />
    </fragment>
    <fragment android:id="@+id/reviewFragment" android:name="com.fandazi.app.feature.review.ReviewFragment" android:label="发布评价">
        <argument android:name="orderId" app:argType="string" />
    </fragment>
    <fragment android:id="@+id/helpFaqFragment" android:name="com.fandazi.app.feature.support.HelpFaqFragment" android:label="帮助与客服" />
    <fragment android:id="@+id/complaintFragment" android:name="com.fandazi.app.feature.support.ComplaintFragment" android:label="投诉与反馈">
        <argument android:name="orderId" app:argType="string" android:defaultValue="" />
    </fragment>
    <!-- 本人记忆正式入口；延期核销节点不纳入Task10提交。 -->
    <fragment android:id="@+id/memoryFragment" android:name="com.fandazi.app.feature.memory.MemoryFragment" android:label="AI记忆" />
</navigation>
