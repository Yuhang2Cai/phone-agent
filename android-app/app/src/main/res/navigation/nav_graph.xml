<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/authFragment">

    <fragment
        android:id="@+id/authFragment"
        android:name="com.fandazi.app.feature.auth.AuthFragment"
        android:label="@string/login" />

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.fandazi.app.feature.home.HomeFragment"
        android:label="@string/home" />

    <fragment
        android:id="@+id/agentChatFragment"
        android:name="com.fandazi.app.feature.agent.AgentChatFragment"
        android:label="AI 助手" />

    <fragment android:id="@+id/searchFragment" android:name="com.fandazi.app.feature.search.SearchFragment" android:label="@string/search_page" />
    <fragment android:id="@+id/merchantFragment" android:name="com.fandazi.app.feature.merchant.MerchantFragment" android:label="@string/merchant_page">
        <argument android:name="merchantId" app:argType="long" />
    </fragment>
    <fragment android:id="@+id/ordersFragment" android:name="com.fandazi.app.feature.order.OrdersFragment" android:label="@string/orders_page" />
    <fragment android:id="@+id/profileFragment" android:name="com.fandazi.app.feature.profile.ProfileFragment" android:label="@string/profile_page" />
    <fragment android:id="@+id/addressFragment" android:name="com.fandazi.app.feature.profile.AddressFragment" android:label="@string/address_title" />
    <fragment android:id="@+id/addressEditFragment" android:name="com.fandazi.app.feature.profile.AddressEditFragment" android:label="@string/address_edit_title" />
    <fragment android:id="@+id/automationSettingsFragment" android:name="com.fandazi.app.feature.profile.AutomationSettingsFragment" android:label="@string/automation_title" />
    <fragment android:id="@+id/cartFragment" android:name="com.fandazi.app.feature.order.CartFragment" android:label="@string/cart_title" />
    <fragment android:id="@+id/paymentFragment" android:name="com.fandazi.app.feature.order.PaymentFragment" android:label="@string/payment_page" />
    <fragment android:id="@+id/storeFragment" android:name="com.fandazi.app.feature.store.StoreFragment" android:label="门店详情">
        <argument android:name="storePublicId" app:argType="string" />
    </fragment>
    <fragment android:id="@+id/dealDetailFragment" android:name="com.fandazi.app.feature.deal.DealDetailFragment" android:label="团购套餐">
        <argument android:name="dealPublicId" app:argType="string" />
        <argument android:name="storePublicId" app:argType="string" />
    </fragment>
</navigation>
