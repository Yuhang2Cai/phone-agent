<?xml version="1.0" encoding="utf-8"?>
<!-- 原生容器仅占内容区，底栏由 MainActivity 绘制；错误层不依赖 RN 成功启动。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#FFF9EC">
    <androidx.fragment.app.FragmentContainerView android:id="@+id/activity_react_container"
        android:layout_width="match_parent" android:layout_height="match_parent" />
    <FrameLayout android:id="@+id/activity_native_error" android:visibility="gone"
        android:layout_width="match_parent" android:layout_height="match_parent" />
</FrameLayout>
