<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="132dp"
    android:layout_height="60dp"
    android:layout_marginEnd="9dp"
    android:background="@drawable/home_card_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="7dp">
    <ImageView android:id="@+id/category_image" android:layout_width="46dp" android:layout_height="46dp" android:contentDescription="餐品图片" android:scaleType="centerCrop" android:src="@drawable/home_merchant_2" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/category_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:text="健康轻食" android:textColor="@color/home_ink" android:textSize="13sp" android:textStyle="bold" />
        <TextView android:id="@+id/category_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:ellipsize="end" android:maxLines="1" android:text="轻盈无负担" android:textColor="@color/home_secondary" android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
