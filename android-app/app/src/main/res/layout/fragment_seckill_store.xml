<?xml version="1.0" encoding="utf-8"?>
<!-- 秒杀用户端确认稿原生布局；业务文字和状态由服务器快照绑定。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/sk_store_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/group_buy_background">
    <LinearLayout android:id="@+id/sk_nav" android:layout_width="match_parent" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:layout_height="52dp">
        <ImageView android:id="@+id/sk_back" style="@style/SkIconAction" android:src="@drawable/sk_32431" android:contentDescription="返回" android:importantForAccessibility="yes"/>
        <TextView android:id="@+id/sk_nav_title" style="@style/SkTitle" android:layout_width="0dp" android:layout_weight="1" android:textSize="17sp" android:layout_marginStart="12dp" android:text="限时秒杀"/>
        <ImageView android:id="@+id/sk_orders" style="@style/SkOrdersAction" android:src="@drawable/sk_933f5" android:contentDescription="我的订单" android:importantForAccessibility="yes"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/sk_list_header" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="16dp">
        <LinearLayout android:id="@+id/sk_store_header" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="8dp">
            <FrameLayout android:layout_width="64dp" android:layout_height="64dp" android:background="@drawable/sk_bg_green">
                <ImageView android:id="@+id/sk_store_icon" android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/sk_62040" android:importantForAccessibility="no" android:layout_gravity="center"/>
            </FrameLayout>
            <LinearLayout android:id="@+id/sk_store_intro" android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1" android:layout_marginStart="12dp">
                <TextView android:id="@+id/sk_store_slogan" style="@style/SkTitle" android:text="今天，好好吃饭。" android:textSize="24sp"/>
                <TextView android:id="@+id/sk_store_caption" style="@style/SkMuted" android:text="到店享用 · 限时好券" android:layout_marginTop="5dp"/>
            </LinearLayout>
        </LinearLayout>
        <!-- 三个栏目均可点击，行高至少48dp，避免只有文字可触达。 -->
        <LinearLayout android:id="@+id/sk_store_tabs" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="12dp">
            <!-- 宽度同样设置下限，避免字形度量或短文案让触达宽度退回内容宽度。 -->
            <TextView android:id="@+id/sk_tab_deals" android:minWidth="48dp" android:minHeight="48dp" android:gravity="center_vertical" style="@style/SkText" android:layout_width="wrap_content" android:text="团购套餐" android:textColor="#FFFFFF" android:background="@drawable/sk_bg_green" android:padding="8dp"/>
            <TextView android:id="@+id/sk_tab_dishes" android:minHeight="48dp" android:gravity="center_vertical" style="@style/SkMuted" android:layout_width="72dp" android:layout_marginStart="24dp" android:text="菜品" android:paddingVertical="8dp"/>
            <TextView android:id="@+id/sk_tab_reviews" android:minHeight="48dp" android:gravity="center_vertical" style="@style/SkMuted" android:layout_width="72dp" android:text="评价" android:paddingVertical="8dp"/>
        </LinearLayout>
        <TextView android:id="@+id/sk_list_title" style="@style/SkTitle" android:text="限时好券" android:textSize="18sp" android:layout_marginTop="12dp"/>
        <TextView android:id="@+id/sk_list_message" style="@style/SkMuted" android:layout_marginTop="8dp"/>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/sk_activity_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:padding="16dp"/>
    <LinearLayout android:id="@+id/sk_footer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="16dp" android:paddingTop="12dp" android:paddingBottom="16dp" android:background="#FFFFFF">
        <TextView android:id="@+id/sk_hint" style="@style/SkMuted" android:gravity="center" android:textSize="11sp"/>
        <TextView android:id="@+id/sk_primary" style="@style/SkAction"/>
    </LinearLayout>
</LinearLayout>
