<?xml version="1.0" encoding="utf-8"?>
<!-- UI-08，Figma 29:59：订单摘要、唯一模拟支付方式、应付金额和演示说明。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/group_buy_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:gravity="center_vertical" android:paddingHorizontal="16dp">
        <TextView android:id="@+id/group_payment_back" style="@style/Task6.Text" android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:text="‹" android:textSize="34sp" android:contentDescription="返回"/>
        <TextView style="@style/Task6.Title" android:layout_width="0dp" android:layout_weight="1" android:gravity="center" android:text="模拟支付"/>
        <Space android:layout_width="48dp" android:layout_height="48dp"/>
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <!-- 订单摘要与金额回读本人订单，不使用导航标题或金额。 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/after_sale_card" android:padding="18dp" android:gravity="center_vertical">
            <ImageView android:id="@+id/group_payment_image" android:layout_width="112dp" android:layout_height="112dp" android:scaleType="centerCrop" android:contentDescription="套餐图片"/>
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="18dp" android:orientation="vertical">
                <TextView android:id="@+id/group_payment_order" style="@style/Task6.Text" android:textSize="19sp" android:textStyle="bold"/>
                <TextView android:id="@+id/group_payment_store" style="@style/Task6.Muted" android:layout_marginTop="8dp"/>
                <TextView android:id="@+id/group_payment_quantity" style="@style/Task6.Muted" android:layout_marginTop="10dp"/>
                <TextView android:id="@+id/group_payment_summary_amount" style="@style/Task6.Amount" android:gravity="end"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:background="@drawable/after_sale_card" android:orientation="vertical" android:padding="24dp">
            <TextView style="@style/Task6.Text" android:text="支付方式" android:textSize="20sp" android:textStyle="bold"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:gravity="center_vertical">
                <ImageView android:layout_width="46dp" android:layout_height="46dp" android:src="@drawable/purchase_method" android:contentDescription="模拟支付"/>
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:orientation="vertical">
                    <TextView style="@style/Task6.Text" android:text="模拟支付" android:textSize="18sp" android:textStyle="bold"/>
                    <TextView style="@style/Task6.Muted" android:text="仅用于演示支付流程" android:textSize="13sp" android:layout_marginTop="8dp"/>
                </LinearLayout>
                <TextView style="@style/Task6.Text" android:layout_width="30dp" android:layout_height="30dp" android:background="@drawable/purchase_selected" android:text="✓" android:textColor="@android:color/white" android:gravity="center" android:contentDescription="已选中"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="86dp" android:layout_marginTop="20dp" android:background="@drawable/after_sale_card" android:padding="24dp" android:gravity="center_vertical">
            <TextView style="@style/Task6.Text" android:layout_width="0dp" android:layout_weight="1" android:text="应付金额" android:textSize="18sp" android:textStyle="bold"/>
            <TextView android:id="@+id/group_payment_amount" style="@style/Task6.Amount" android:layout_width="wrap_content" android:textSize="27sp"/>
        </LinearLayout>
        <TextView style="@style/Task6.Muted" android:layout_marginTop="24dp" android:padding="16dp" android:background="@drawable/after_sale_card" android:text="本页面仅用于演示，不会产生真实支付。" android:textSize="13sp"/>
        <TextView android:id="@+id/group_payment_status" style="@style/Task6.Muted" android:layout_marginTop="12dp" android:textColor="@color/warning_red"/>
    </LinearLayout>
    </ScrollView>
    <!-- 底部支付按钮固定尺寸；读单失败只能重试，不能凭缺省金额付款。 -->
    <TextView android:id="@+id/group_payment_action" style="@style/Task6.Action" android:layout_marginHorizontal="32dp" android:layout_marginBottom="24dp" android:text="确认支付" android:enabled="false"/>
</LinearLayout>
