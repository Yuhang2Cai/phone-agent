<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/dish_card" android:layout_width="match_parent" android:layout_height="122dp" android:layout_marginBottom="8dp" android:background="@drawable/search_merchant_card" android:clickable="true" android:focusable="true">
    <ImageView android:id="@+id/dish_image" android:layout_width="100dp" android:layout_height="96dp" android:layout_gravity="start|center_vertical" android:layout_marginStart="7dp" android:contentDescription="菜品图片" android:scaleType="centerCrop" android:src="@drawable/home_merchant_3" />
    <TextView android:id="@+id/dish_name" android:layout_width="170dp" android:layout_height="wrap_content" android:layout_marginStart="116dp" android:layout_marginTop="10dp" android:ellipsize="end" android:maxLines="1" android:textColor="@color/brand_ink" android:textSize="16sp" android:textStyle="bold" />
    <TextView android:id="@+id/dish_description" android:layout_width="190dp" android:layout_height="wrap_content" android:layout_marginStart="116dp" android:layout_marginTop="35dp" android:ellipsize="end" android:maxLines="2" android:textColor="@color/brand_muted" android:textSize="11sp" />
    <TextView android:id="@+id/dish_tags" android:layout_width="170dp" android:layout_height="wrap_content" android:layout_marginStart="116dp" android:layout_marginTop="72dp" android:ellipsize="end" android:maxLines="1" android:textColor="#A56543" android:textSize="10sp" />
    <TextView android:id="@+id/dish_price" android:layout_width="100dp" android:layout_height="wrap_content" android:layout_marginStart="116dp" android:layout_marginTop="94dp" android:textColor="@color/brand_orange" android:textSize="17sp" android:textStyle="bold" />
    <TextView android:id="@+id/dish_add" android:layout_width="38dp" android:layout_height="38dp" android:layout_gravity="end|bottom" android:layout_marginEnd="8dp" android:layout_marginBottom="9dp" android:background="@drawable/search_button_background" android:contentDescription="浏览菜品" android:gravity="center" android:text="+" android:textColor="@color/surface_card" android:textSize="25sp" />
</FrameLayout>
