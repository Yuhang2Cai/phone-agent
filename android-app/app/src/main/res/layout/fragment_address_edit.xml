<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#FFF9F4" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="28dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="68dp" android:gravity="center_vertical">
            <ImageButton android:id="@+id/address_edit_back" android:layout_width="44dp" android:layout_height="44dp" android:background="@android:color/transparent" android:contentDescription="@string/back" android:src="@drawable/ic_back" />
            <TextView android:id="@+id/address_edit_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/address_edit_title" android:textColor="#171411" android:textSize="27sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/address_card_background" android:orientation="vertical" android:padding="18dp">
            <EditText android:id="@+id/address_recipient" style="@style/ProfileInput" android:hint="@string/address_recipient_hint" />
            <EditText android:id="@+id/address_phone" style="@style/ProfileInput" android:hint="@string/address_phone_hint" android:inputType="phone" />
            <EditText android:id="@+id/address_detail" style="@style/ProfileInput" android:gravity="top" android:hint="@string/address_detail_hint" android:inputType="textMultiLine" android:minLines="3" />
            <CheckBox android:id="@+id/address_default" android:layout_width="wrap_content" android:layout_height="48dp" android:buttonTint="@color/brand_orange" android:text="@string/address_default" android:textColor="@color/brand_ink" />
        </LinearLayout>
        <TextView android:id="@+id/address_save" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="20dp" android:background="@drawable/bg_primary_pill" android:contentDescription="@string/address_save" android:gravity="center" android:text="@string/address_save" android:textColor="@color/surface_card" android:textSize="17sp" android:textStyle="bold" />
        <TextView android:id="@+id/address_delete" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="12dp" android:background="@drawable/address_delete_background" android:contentDescription="删除地址" android:gravity="center" android:text="删除地址" android:textColor="@color/warning_red" android:textSize="16sp" android:visibility="gone" />
    </LinearLayout>
</ScrollView>
