<?xml version="1.0" encoding="utf-8"?>
<!-- 常见问题由接口逐条填入；答案只在用户展开时显示，不重复维护本地规则文本。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
    android:paddingHorizontal="12dp" android:paddingVertical="13dp">
    <LinearLayout android:id="@+id/faq_row_header" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="60dp"
        android:gravity="center_vertical">
        <!-- 正式图标来自已确认 Figma，业务标题和正文仍由每个接口条目绑定。 -->
        <ImageView android:id="@+id/faq_row_icon" android:layout_width="45dp" android:layout_height="45dp" android:layout_marginEnd="12dp" android:importantForAccessibility="no" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/faq_row_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/after_sale_ink" android:textSize="16sp" android:textStyle="bold" />
            <!-- 折叠摘要也取真实答案，单行省略不改变展开后的完整规则。 -->
            <TextView android:id="@+id/faq_row_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp"
                android:maxLines="1" android:ellipsize="end" android:textColor="@color/after_sale_muted" android:textSize="12sp" />
        </LinearLayout>
        <TextView android:id="@+id/faq_row_arrow" android:layout_width="28dp" android:layout_height="wrap_content"
            android:gravity="center" android:text="›" android:textColor="@color/after_sale_muted" android:textSize="24sp" />
    </LinearLayout>
    <TextView android:id="@+id/faq_row_answer" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingBottom="8dp" android:textColor="@color/after_sale_muted" android:textSize="13sp" android:visibility="gone" />
</LinearLayout>
