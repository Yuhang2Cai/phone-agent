<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingTop="12dp" android:paddingBottom="12dp">
    <ImageView android:id="@+id/cart_dish_image" android:layout_width="78dp" android:layout_height="78dp" android:contentDescription="购物车菜品图片" android:scaleType="centerCrop" android:src="@drawable/home_merchant_3" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/cart_dish_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/brand_ink" android:textSize="15sp" android:textStyle="bold" />
        <TextView android:id="@+id/cart_dish_options" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:ellipsize="end" android:maxLines="1" android:textColor="@color/brand_muted" android:textSize="12sp" />
        <TextView android:id="@+id/cart_dish_price" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/brand_orange" android:textSize="16sp" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:layout_width="wrap_content" android:layout_height="40dp" android:gravity="center" android:orientation="horizontal">
        <TextView android:id="@+id/cart_minus" android:layout_width="34dp" android:layout_height="34dp" android:background="@drawable/dish_option_unselected" android:contentDescription="减少菜品数量" android:gravity="center" android:text="−" android:textSize="20sp" />
        <TextView android:id="@+id/cart_quantity" android:layout_width="34dp" android:layout_height="34dp" android:contentDescription="购物车菜品数量" android:gravity="center" android:textColor="@color/brand_ink" android:textStyle="bold" />
        <TextView android:id="@+id/cart_plus" android:layout_width="34dp" android:layout_height="34dp" android:background="@drawable/dish_option_selected" android:contentDescription="增加菜品数量" android:gravity="center" android:text="+" android:textColor="@color/brand_orange" android:textSize="20sp" />
    </LinearLayout>
</LinearLayout>
