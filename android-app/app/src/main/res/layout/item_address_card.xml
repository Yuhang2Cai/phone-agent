<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/address_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/address_card_background" android:gravity="center_vertical" android:minHeight="116dp" android:orientation="horizontal" android:paddingStart="14dp" android:paddingTop="14dp" android:paddingEnd="12dp" android:paddingBottom="14dp">
    <TextView android:id="@+id/address_radio" android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/address_radio_unselected" android:contentDescription="设为默认地址" android:gravity="center" android:textColor="@color/surface_card" android:textSize="16sp" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/address_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="#171411" android:textSize="18sp" android:textStyle="bold" />
            <TextView android:id="@+id/address_default_badge" android:layout_width="wrap_content" android:layout_height="28dp" android:layout_marginStart="10dp" android:background="@drawable/address_default_badge_background" android:gravity="center" android:paddingHorizontal="10dp" android:text="@string/address_default_tag" android:textColor="#16962B" android:textSize="13sp" android:visibility="gone" />
        </LinearLayout>
        <TextView android:id="@+id/address_detail_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:maxLines="2" android:textColor="#566071" android:textSize="14sp" />
        <TextView android:id="@+id/address_contact" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textColor="#566071" android:textSize="14sp" />
        <TextView android:id="@+id/address_invalid_badge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="@string/address_invalid" android:textColor="@color/warning_red" android:textSize="12sp" android:visibility="gone" />
    </LinearLayout>
    <TextView android:id="@+id/address_edit" android:layout_width="40dp" android:layout_height="56dp" android:contentDescription="编辑地址" android:gravity="center" android:text="›" android:textColor="#272A30" android:textSize="34sp" />
</LinearLayout>
