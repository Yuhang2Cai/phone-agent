<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#FFF9F4" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="28dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="68dp" android:gravity="center_vertical">
            <ImageButton android:id="@+id/automation_back" android:layout_width="44dp" android:layout_height="44dp" android:background="@android:color/transparent" android:contentDescription="@string/back" android:src="@drawable/ic_back" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/automation_title" android:textColor="#171411" android:textSize="27sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout android:id="@+id/automation_banner" android:layout_width="match_parent" android:layout_height="126dp" android:background="@drawable/address_banner_background" android:gravity="center_vertical" android:orientation="horizontal" android:padding="14dp">
            <ImageView android:layout_width="64dp" android:layout_height="64dp" android:contentDescription="饭搭子 AI 助手" android:src="@drawable/brand_mascot_rounded" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/automation_banner_title" android:textColor="#171411" android:textSize="16sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:lineSpacingExtra="2dp" android:text="@string/automation_banner_subtitle" android:textColor="#6E7481" android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/address_card_background" android:orientation="vertical" android:paddingHorizontal="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="84dp" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/automation_icon_background" android:gravity="center" android:text="▢" android:textColor="#F05420" android:textSize="23sp" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/automation_this_task" android:textColor="#171411" android:textSize="17sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="开启后，本次对话中确认后自动下单" android:textColor="#747C8C" android:textSize="12sp" />
                </LinearLayout>
                <androidx.appcompat.widget.SwitchCompat android:id="@+id/automation_this_task" android:layout_width="wrap_content" android:layout_height="48dp" android:contentDescription="@string/automation_this_task" app:thumbTint="@color/automation_switch_thumb" app:trackTint="@color/automation_switch_track" />
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#FFF0E8" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="98dp" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/automation_icon_background" android:gravity="center" android:text="↻" android:textColor="#F05420" android:textSize="25sp" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/automation_long_term" android:textColor="#171411" android:textSize="17sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="按你的偏好点餐，下单前仍会请你确认" android:textColor="#747C8C" android:textSize="12sp" />
                </LinearLayout>
                <androidx.appcompat.widget.SwitchCompat android:id="@+id/automation_long_term" android:layout_width="wrap_content" android:layout_height="48dp" android:contentDescription="@string/automation_long_term" app:thumbTint="@color/automation_switch_thumb" app:trackTint="@color/automation_switch_track" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:id="@+id/automation_limit_card" android:layout_width="match_parent" android:layout_height="82dp" android:layout_marginTop="14dp" android:background="@drawable/address_card_background" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="16dp">
            <TextView android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/automation_icon_background" android:gravity="center" android:text="¥" android:textColor="#F05420" android:textSize="26sp" android:textStyle="bold" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/automation_limit_title" android:textColor="#171411" android:textSize="17sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="单次订单的最高金额" android:textColor="#747C8C" android:textSize="12sp" />
            </LinearLayout>
            <EditText android:id="@+id/automation_limit" android:layout_width="74dp" android:layout_height="48dp" android:background="@android:color/transparent" android:gravity="end|center_vertical" android:hint="¥30" android:inputType="numberDecimal" android:maxLines="1" android:textColor="#171411" android:textSize="18sp" />
            <TextView android:layout_width="20dp" android:layout_height="48dp" android:gravity="center" android:text="›" android:textColor="#272A30" android:textSize="28sp" />
        </LinearLayout>

        <TextView android:id="@+id/automation_address" android:layout_width="match_parent" android:layout_height="82dp" android:layout_marginTop="14dp" android:background="@drawable/address_card_background" android:drawableStart="@drawable/ic_location_orange" android:drawablePadding="14dp" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:text="@string/automation_address_empty" android:textColor="#171411" android:textSize="16sp" android:textStyle="bold" />

        <TextView android:id="@+id/automation_block_reason" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center" android:textColor="@color/warning_red" android:textSize="13sp" />

        <TextView android:id="@+id/automation_notice" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/address_banner_background" android:lineSpacingExtra="3dp" android:padding="18dp" android:text="@string/automation_notice" android:textColor="#68707D" android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
