<?xml version="1.0" encoding="utf-8"?>
<!-- UI16A真实菜图104dp、卡片128dp，点击卡片看详情，独立按钮只改变公开ID选择。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="12dp">
<LinearLayout android:id="@+id/compare_item_card" android:layout_width="match_parent" android:layout_height="128dp" android:padding="12dp" android:background="@drawable/group_buy_card_background" android:orientation="horizontal">
<ImageView android:id="@+id/compare_item_image" android:layout_width="104dp" android:layout_height="104dp" android:scaleType="centerCrop" android:background="@drawable/compare_photo" android:clipToOutline="true" />
<LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="16dp" android:orientation="vertical" android:gravity="center_vertical">
<TextView android:id="@+id/compare_item_title" style="@style/CompareText" android:textSize="17sp" android:maxLines="2" android:ellipsize="end" />
<TextView android:id="@+id/compare_item_store" style="@style/CompareCaption" android:layout_marginTop="8dp" android:maxLines="1" android:ellipsize="end" />
<TextView android:id="@+id/compare_item_price" style="@style/CompareText" android:textColor="@color/group_buy_orange" android:textSize="18sp" android:layout_marginTop="10dp" />
</LinearLayout></LinearLayout>
<TextView android:id="@+id/compare_item_toggle" style="@style/CompareButton" android:layout_marginTop="8dp" />
</LinearLayout>
