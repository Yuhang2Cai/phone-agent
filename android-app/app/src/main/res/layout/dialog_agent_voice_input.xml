<?xml version="1.0" encoding="utf-8"?>
<!-- UI-14E/G/H统一弹窗结构：文字可滚动，长草稿不挤掉明确的追加/替换/取消操作。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="@drawable/agent_voice_panel_background" android:orientation="vertical" android:padding="16dp">
    <TextView android:id="@+id/agent_voice_dialog_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="19sp" android:textStyle="bold" android:textColor="@color/group_buy_green" />
    <ScrollView android:id="@+id/agent_voice_dialog_scroll" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
        android:fillViewport="false" android:overScrollMode="ifContentScrolls">
        <TextView android:id="@+id/agent_voice_dialog_body" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="14sp" android:lineSpacingExtra="5dp" android:textColor="@color/group_buy_muted" />
    </ScrollView>
    <TextView android:id="@+id/agent_voice_dialog_primary" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="8dp"
        android:background="@drawable/agent_voice_primary_background" android:gravity="center" android:textSize="14sp" android:textColor="@color/surface_card" />
    <TextView android:id="@+id/agent_voice_dialog_secondary" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="8dp"
        android:background="@drawable/agent_voice_primary_background" android:gravity="center" android:textSize="14sp" android:textColor="@color/surface_card" />
    <TextView android:id="@+id/agent_voice_dialog_cancel" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="8dp"
        android:background="@drawable/agent_voice_secondary_background" android:gravity="center" android:textSize="14sp" android:textColor="@color/surface_card" />
</LinearLayout>
