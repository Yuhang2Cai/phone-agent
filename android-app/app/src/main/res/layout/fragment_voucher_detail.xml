<?xml version="1.0" encoding="utf-8"?>
<!-- UI12：套餐图片、券状态、订单信息和后端套餐说明；延期核销入口始终隐藏，不申请令牌。 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/group_buy_background" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="8dp" android:text="团购券详情" android:textColor="@color/group_buy_green" android:textSize="26sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="8dp" android:text="核销暂未开放" android:textColor="@color/group_buy_muted" android:textSize="13sp" />
        <TextView android:id="@+id/voucher_detail_error" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp" android:textColor="@color/group_buy_muted" />
        <TextView android:id="@+id/voucher_detail_retry" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/search_button_background" android:gravity="center" android:text="点击重试" android:textColor="@android:color/white" android:visibility="gone" />
        <LinearLayout android:id="@+id/voucher_detail_body" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="112dp" android:background="@drawable/group_buy_card_background" android:orientation="horizontal" android:padding="16dp">
                <ImageView android:id="@+id/voucher_detail_image" android:layout_width="80dp" android:layout_height="80dp" android:scaleType="centerCrop" android:contentDescription="套餐图片" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="16dp" android:orientation="vertical">
                    <TextView android:id="@+id/voucher_detail_store" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/group_buy_text" android:textSize="16sp" android:textStyle="bold" />
                    <TextView android:id="@+id/voucher_detail_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/group_buy_text" android:textSize="14sp" />
                    <TextView android:id="@+id/voucher_detail_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textColor="@color/group_buy_orange" android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:background="@drawable/group_buy_card_background" android:orientation="vertical" android:padding="16dp">
                <TextView android:id="@+id/voucher_detail_info" android:layout_width="match_parent" android:layout_height="wrap_content" android:lineSpacingExtra="12dp" android:textColor="@color/group_buy_text" android:textSize="12sp" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="30dp" android:paddingHorizontal="8dp" android:text="使用规则" android:textColor="@color/group_buy_green" android:textSize="16sp" android:textStyle="bold" />
            <TextView android:id="@+id/voucher_detail_rules" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:paddingHorizontal="8dp" android:textColor="@color/group_buy_muted" android:textSize="13sp" />
            <!-- 退款只导航；原 Task8 进度入口保留，不能据 canRefund=false 推断存在申请。 -->
            <TextView android:id="@+id/voucher_refund" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="24dp" android:background="@drawable/after_sale_outline" android:gravity="center" android:text="申请退款" android:textColor="@color/group_buy_orange" android:textSize="16sp" android:visibility="gone" />
            <TextView android:id="@+id/voucher_refund_progress" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="16dp" android:background="@drawable/after_sale_outline" android:gravity="center" android:text="查看退款进度" android:textColor="@color/group_buy_orange" android:textSize="16sp" android:visibility="gone" />
        </LinearLayout>
        <!-- 保留延期设计源码但无可见调用入口；不将 QR 或核销路由纳入 Task7 交付。 -->
        <TextView android:id="@+id/voucher_show_code" android:layout_width="match_parent" android:layout_height="56dp" android:visibility="gone" android:enabled="false" />
    </LinearLayout>
</ScrollView>
