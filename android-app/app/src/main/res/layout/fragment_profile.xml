<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/surface_background" android:fillViewport="true"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
    <TextView android:id="@+id/profile_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/profile_page" android:textColor="@color/brand_ink" android:textSize="24sp" android:textStyle="bold" />
    <LinearLayout android:id="@+id/profile_account_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:background="@drawable/bg_profile_card" android:orientation="vertical"><TextView android:id="@+id/profile_account_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/profile_account_name" android:textColor="@color/brand_ink" android:textSize="18sp" android:textStyle="bold" /><TextView android:id="@+id/profile_guest_hint" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/profile_guest_hint" android:textColor="@color/brand_muted" android:textSize="14sp" /></LinearLayout>
    <TextView android:id="@+id/profile_address_entry" android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="12dp" android:background="@drawable/bg_profile_card" android:contentDescription="@string/profile_address_entry" android:gravity="center_vertical" android:padding="16dp" android:text="@string/profile_address_entry" android:textColor="@color/brand_ink" android:textSize="16sp" android:textStyle="bold" />
    <TextView android:id="@+id/profile_automation_entry" android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="12dp" android:background="@drawable/bg_profile_card" android:contentDescription="@string/profile_automation_entry" android:gravity="center_vertical" android:padding="16dp" android:text="@string/profile_automation_entry" android:textColor="@color/brand_ink" android:textSize="16sp" android:textStyle="bold" />
    <TextView android:id="@+id/profile_logout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:background="@drawable/bg_profile_card" android:gravity="center" android:minHeight="48dp" android:paddingVertical="12dp" android:text="@string/logout" android:textColor="@color/warning_red" android:textSize="14sp" />
</LinearLayout></ScrollView>
