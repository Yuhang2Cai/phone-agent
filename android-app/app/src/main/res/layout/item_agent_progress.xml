<?xml version="1.0" encoding="utf-8"?>
<!-- 复合任务进度卡：步骤名称和状态来自服务端事件，不在客户端推断。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/agent_progress_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:background="@drawable/agent_chat_bot_bubble"
    android:orientation="vertical"
    android:padding="16dp">
    <TextView
        android:id="@+id/agent_progress_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="正在为你处理"
        android:textColor="@color/group_buy_text"
        android:textSize="16sp"
        android:textStyle="bold" />
    <LinearLayout
        android:id="@+id/agent_progress_steps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical" />
</LinearLayout>
