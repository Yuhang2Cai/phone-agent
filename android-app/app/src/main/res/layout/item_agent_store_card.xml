<?xml version="1.0" encoding="utf-8"?>
<!-- 门店推荐卡：业务名称、评分、距离和地址全部使用网关补全后的字段。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/agent_store_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:background="@drawable/group_buy_card_background"
    android:orientation="horizontal"
    android:padding="16dp">
    <ImageView
        android:id="@+id/agent_store_image"
        android:layout_width="92dp"
        android:layout_height="92dp"
        android:contentDescription="门店图片"
        android:scaleType="centerCrop"
        android:src="@drawable/merchant_cover_placeholder" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/agent_store_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/group_buy_green"
            android:textSize="18sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/agent_store_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:textColor="@color/group_buy_orange"
            android:textSize="15sp" />
        <TextView
            android:id="@+id/agent_store_address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:maxLines="2"
            android:textColor="@color/group_buy_muted"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/agent_store_action"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_gravity="end"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="查看详情"
            android:textColor="@color/group_buy_orange"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
