<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="116dp"
    android:layout_marginTop="10dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="#FFFFFC"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:strokeColor="#F1E8E0"
    app:strokeWidth="1dp">
    <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
        <ImageView
            android:id="@+id/merchant_background_image"
            android:layout_width="162dp"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:alpha="0.24"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:src="@drawable/home_merchant_1" />
        <View
            android:layout_width="190dp"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:background="@drawable/home_merchant_image_fade" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:padding="8dp">
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/merchant_food_image"
            android:layout_width="98dp"
            android:layout_height="98dp"
            android:contentDescription="商家招牌菜图片"
            android:scaleType="centerCrop"
            android:src="@drawable/home_merchant_1"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.FandaziAi.HomeFood" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/merchant_name" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="1" android:textColor="@color/home_ink" android:textSize="15sp" android:textStyle="bold" />
                <TextView android:id="@+id/merchant_distance" android:layout_width="wrap_content" android:layout_height="24dp" android:layout_marginStart="4dp" android:background="@drawable/home_distance_background" android:gravity="center" android:paddingStart="6dp" android:paddingEnd="6dp" android:text="● 1.2 km" android:textColor="#3E7A3A" android:textSize="9sp" />
            </LinearLayout>
            <TextView android:id="@+id/merchant_meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:ellipsize="end" android:maxLines="1" android:textColor="@color/home_orange" android:textSize="10sp" />
            <TextView android:id="@+id/merchant_tags" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:ellipsize="end" android:maxLines="1" android:textColor="#9B6549" android:textSize="10sp" />
            <TextView android:id="@+id/merchant_quote" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:ellipsize="end" android:maxLines="1" android:text="食材新鲜，饭搭子推荐" android:textColor="#8C8585" android:textSize="9sp" />
        </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</com.google.android.material.card.MaterialCardView>
