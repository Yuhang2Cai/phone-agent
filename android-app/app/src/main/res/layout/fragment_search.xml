<?xml version="1.0" encoding="utf-8"?>
<!-- 通过AppCompat着色兼容API26；图标及Figma色值不变。 -->
<!-- 搜索与筛选结果 UI-02：复用首页分类、排序和团购门店卡片。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/group_buy_background" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="76dp" android:background="@color/group_buy_green" android:gravity="bottom|center_vertical" android:orientation="horizontal" android:paddingStart="8dp" android:paddingEnd="10dp" android:paddingBottom="8dp">
        <ImageButton android:id="@+id/search_back" android:layout_width="38dp" android:layout_height="44dp" android:background="@android:color/transparent" android:contentDescription="返回" android:padding="9dp" android:src="@drawable/ic_back" app:tint="@color/surface_card" />
        <LinearLayout android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:background="@drawable/group_buy_search_background" android:gravity="center_vertical" android:paddingStart="12dp">
            <ImageView android:layout_width="21dp" android:layout_height="21dp" android:contentDescription="搜索" android:src="@drawable/ic_home_search" />
            <!-- 搜索提交采用系统键盘搜索动作，避免每次输入字符都发真实业务请求。 -->
            <EditText android:id="@+id/search_input" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="7dp" android:layout_weight="1" android:background="@android:color/transparent" android:hint="搜索餐厅、菜品或商家" android:imeOptions="actionSearch" android:inputType="text" android:singleLine="true" android:textColor="@color/group_buy_text" android:textColorHint="@color/group_buy_muted" android:textSize="14sp" />
            <TextView android:id="@+id/clear_search" android:layout_width="36dp" android:layout_height="match_parent" android:gravity="center" android:text="×" android:textColor="@color/group_buy_muted" android:textSize="22sp" />
        </LinearLayout>
        <TextView android:id="@+id/search_button" android:layout_width="58dp" android:layout_height="44dp" android:layout_marginStart="7dp" android:background="@drawable/group_buy_primary_button" android:gravity="center" android:text="搜索" android:textColor="@color/surface_card" android:textSize="14sp" android:textStyle="bold" />
    </LinearLayout>

    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="58dp" android:scrollbars="none">
        <LinearLayout android:id="@+id/search_categories" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="16dp" />
    </HorizontalScrollView>
    <LinearLayout android:id="@+id/filter_row" android:layout_width="match_parent" android:layout_height="44dp" android:gravity="end|center_vertical" android:orientation="horizontal" android:paddingEnd="14dp" />
    <TextView android:id="@+id/result_count" android:layout_width="match_parent" android:layout_height="32dp" android:gravity="center_vertical" android:paddingStart="14dp" android:textColor="@color/group_buy_muted" android:textSize="12sp" />
    <TextView android:id="@+id/search_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="14dp" android:paddingEnd="14dp" android:textColor="@color/group_buy_muted" android:textSize="11sp" />
    <!-- 固定视图身份配合页面状态保存偏移，详情返回不丢失原局部浏览位置。 -->
    <!-- 有界纵向回收列表保留原结果区内边距，固定筛选控件不进入重复业务行。 -->
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/search_results" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:paddingStart="12dp" android:paddingTop="4dp" android:paddingEnd="12dp" android:paddingBottom="16dp" />
</LinearLayout>
