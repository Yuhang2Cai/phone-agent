<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/surface_background" android:paddingStart="24dp" android:paddingTop="22dp" android:paddingEnd="24dp">
    <TextView android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/search_page" android:textColor="@color/brand_ink" android:textSize="30sp" android:textStyle="bold" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="22dp" android:gravity="center_vertical">
        <EditText android:id="@+id/search_input" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:backgroundTint="@color/brand_ink" android:hint="@string/search_input_hint" android:inputType="text" android:paddingStart="0dp" android:textColor="@color/brand_ink" android:textSize="17sp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/search_button" android:layout_width="96dp" android:layout_height="48dp" android:layout_marginStart="10dp" android:text="@string/search_action" app:cornerRadius="24dp" app:backgroundTint="@color/brand_yellow" android:textColor="@color/brand_ink" />
    </LinearLayout>
    <com.google.android.material.button.MaterialButton android:id="@+id/filter_button" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="0dp" android:text="筛选：全部" android:textColor="@color/brand_orange" />
    <TextView android:id="@+id/search_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/search_ready" android:textColor="@color/brand_muted" android:textSize="15sp" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="10dp">
        <LinearLayout android:id="@+id/search_results" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
    </ScrollView>
    <com.google.android.material.card.MaterialCardView android:id="@+id/agent_fab" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:layout_marginBottom="12dp" android:contentDescription="@string/agent_open" android:clickable="true" android:focusable="true" app:cardBackgroundColor="@color/brand_orange" app:cardCornerRadius="26dp">
        <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="@string/agent_open" android:textColor="#FFFFFF" android:textStyle="bold" />
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
