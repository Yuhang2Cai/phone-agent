<?xml version="1.0" encoding="utf-8"?>
<!-- 秒杀用户端确认稿原生布局；业务文字和状态由服务器快照绑定。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/sk_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/group_buy_background">
    <LinearLayout android:id="@+id/sk_nav" android:layout_width="match_parent" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:layout_height="52dp">
        <ImageView android:id="@+id/sk_back" style="@style/SkIconAction" android:src="@drawable/sk_32431" android:contentDescription="返回" android:importantForAccessibility="yes"/>
        <TextView android:id="@+id/sk_nav_title" style="@style/SkTitle" android:layout_width="0dp" android:layout_weight="1" android:textSize="17sp" android:layout_marginStart="12dp" android:text="限时秒杀"/>
        <ImageView android:id="@+id/sk_orders" style="@style/SkOrdersAction" android:src="@drawable/sk_933f5" android:contentDescription="我的订单" android:importantForAccessibility="yes"/>
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:id="@+id/sk_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="16dp" android:paddingTop="8dp" android:paddingBottom="16dp">
            <LinearLayout android:id="@+id/sk_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="20dp">
                <FrameLayout android:id="@+id/sk_status_badge" android:layout_width="96dp" android:layout_height="96dp" android:background="@drawable/sk_bg_peach">
                    <ImageView android:id="@+id/sk_status_icon" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/sk_9308a" android:importantForAccessibility="no" android:layout_gravity="center"/>
                </FrameLayout>
                <TextView android:id="@+id/sk_status_title" style="@style/SkTitle" android:textSize="24sp" android:layout_marginTop="20dp"/>
                <TextView android:id="@+id/sk_status_description" style="@style/SkMuted" android:textSize="13sp" android:layout_marginTop="8dp"/>
            </LinearLayout>
            <FrameLayout android:id="@+id/sk_hero" android:layout_width="match_parent" android:layout_height="240dp">
                <include layout="@layout/include_seckill_photo"/>
            </FrameLayout>
            <LinearLayout android:id="@+id/sk_price_section" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="12dp">
                <TextView android:id="@+id/sk_title" style="@style/SkTitle"/>
                <LinearLayout android:id="@+id/sk_price_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:id="@+id/sk_price" style="@style/SkTitle" android:layout_width="wrap_content" android:textSize="40sp" android:textColor="@color/group_buy_orange"/>
                    <TextView android:id="@+id/sk_original" style="@style/SkMuted" android:layout_width="wrap_content" android:textSize="14sp" android:layout_marginStart="10dp"/>
                    <TextView android:id="@+id/sk_saving" style="@style/SkMuted" android:layout_width="wrap_content" android:textSize="11sp" android:textColor="@color/group_buy_orange" android:background="@drawable/sk_bg_badge" android:padding="8dp" android:layout_marginStart="10dp"/>
                </LinearLayout>
                <TextView android:id="@+id/sk_description" style="@style/SkMuted" android:textSize="13sp" android:layout_marginTop="3dp"/>
            </LinearLayout>
            <include layout="@layout/include_seckill_timer"/>
            <LinearLayout android:id="@+id/sk_stock_section" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="12dp">
                <LinearLayout android:id="@+id/sk_stock_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:id="@+id/sk_stock" style="@style/SkText" android:layout_width="0dp" android:layout_weight="1" android:textSize="12sp"/>
                    <TextView android:id="@+id/sk_quota" style="@style/SkMuted" android:layout_width="wrap_content" android:textSize="11sp"/>
                </LinearLayout>
                <ProgressBar android:id="@+id/sk_stock_bar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="8dp" android:progressTint="@color/group_buy_orange" android:progressBackgroundTint="#E5E5DE"/>
            </LinearLayout>
            <include layout="@layout/include_seckill_summary"/>
            <LinearLayout android:id="@+id/sk_notice" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:background="@drawable/sk_bg_white" android:layout_marginTop="16dp">
                <ImageView android:id="@+id/sk_notice_icon" android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/sk_20d59" android:importantForAccessibility="no"/>
                <TextView android:id="@+id/sk_notice_title" style="@style/SkTitle" android:textSize="19sp" android:layout_marginTop="12dp"/>
                <TextView android:id="@+id/sk_notice_body" style="@style/SkMuted" android:textSize="13sp" android:layout_marginTop="8dp"/>
            </LinearLayout>
            <include layout="@layout/include_seckill_info"/>
            <include layout="@layout/include_seckill_payment_facts"/>
            <TextView android:id="@+id/sk_facts" style="@style/SkText" android:padding="16dp" android:lineSpacingExtra="10dp" android:background="@drawable/sk_bg_white" android:layout_marginTop="12dp"/>
            <TextView android:id="@+id/sk_note" style="@style/SkMuted" android:padding="12dp" android:textColor="@color/group_buy_green" android:background="@drawable/sk_bg_mint" android:layout_marginTop="12dp"/>
            <TextView android:id="@+id/sk_secondary" style="@style/SkAction" android:background="@drawable/sk_bg_white" android:textColor="@color/group_buy_green"/>
            <TextView android:id="@+id/sk_error" style="@style/SkMuted" android:textColor="@color/group_buy_orange" android:layout_marginTop="12dp" android:accessibilityLiveRegion="polite"/>
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:id="@+id/sk_footer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="16dp" android:paddingTop="12dp" android:paddingBottom="16dp" android:background="#FFFFFF">
        <TextView android:id="@+id/sk_hint" style="@style/SkMuted" android:gravity="center" android:textSize="11sp"/>
        <TextView android:id="@+id/sk_primary" style="@style/SkAction"/>
    </LinearLayout>
</LinearLayout>
