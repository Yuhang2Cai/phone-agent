<?xml version="1.0" encoding="utf-8"?>
<!--
    AI 助手全屏聊天页：只定义页面结构和静态交互控件，门店、套餐、订单等业务内容全部由后端卡片填充。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="12dp">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AI助手"
                android:textColor="@color/group_buy_green"
                android:textSize="27sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="帮你发现更好的餐厅"
                android:textColor="@color/group_buy_muted"
                android:textSize="14sp" />
        </LinearLayout>
        <TextView
            android:id="@+id/agent_chat_close"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="关闭 AI 助手"
            android:gravity="center"
            android:text="×"
            android:textColor="@color/group_buy_text"
            android:textSize="28sp" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/agent_chat_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingHorizontal="16dp"
        android:paddingBottom="16dp">
        <LinearLayout
            android:id="@+id/agent_chat_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp">
        <EditText
            android:id="@+id/agent_chat_input"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="@drawable/agent_composer_background"
            android:hint="有任何美食需求都可以问我…"
            android:inputType="textMultiLine"
            android:maxLines="2"
            android:paddingHorizontal="16dp"
            android:textColor="@color/group_buy_text"
            android:textColorHint="@color/group_buy_muted" />
        <TextView
            android:id="@+id/agent_chat_send"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/search_button_background"
            android:contentDescription="发送消息"
            android:gravity="center"
            android:text="➤"
            android:textColor="@color/surface_card"
            android:textSize="22sp" />
    </LinearLayout>
</LinearLayout>
