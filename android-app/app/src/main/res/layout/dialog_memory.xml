<?xml version="1.0" encoding="utf-8"?>
<!-- UI22D/E/F：确认层使用实际输入与显式提交，取消不调用任何API。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent"
    android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:background="@color/surface_card">
    <TextView android:id="@+id/memory_dialog_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/group_buy_text" />
    <TextView android:id="@+id/memory_dialog_message" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textSize="16sp" android:textColor="@color/group_buy_text" />
    <EditText android:id="@+id/memory_dialog_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:layout_marginTop="12dp" android:inputType="textCapSentences" android:maxLength="256" android:background="@drawable/after_sale_input" android:padding="12dp" android:visibility="gone" android:importantForAutofill="no" />
    <!-- 显式使用品牌橙色，避免AppCompat主题把自定义背景染成旧黄色。 -->
    <Button android:id="@+id/memory_dialog_confirm" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="12dp" android:background="@drawable/group_buy_primary_button" app:backgroundTint="@color/group_buy_orange" android:textColor="@color/surface_card" android:textSize="18sp" />
    <TextView android:id="@+id/memory_dialog_cancel" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="12dp" android:gravity="center" android:text="取消" android:textSize="16sp" android:textColor="@color/group_buy_muted" />
</LinearLayout>
