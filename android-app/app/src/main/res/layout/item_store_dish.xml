<?xml version="1.0" encoding="utf-8"?>
<!-- 门店菜品页只展示菜品，不提供外卖加购、规格选择或购物车入口。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="91dp" android:gravity="center_vertical" android:orientation="horizontal">
    <ImageView android:id="@+id/dish_cover" android:layout_width="102dp" android:layout_height="76dp" android:contentDescription="菜品图片" android:scaleType="centerCrop" />
    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="12dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="vertical">
        <TextView android:id="@+id/dish_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/group_buy_text" android:textSize="16sp" android:textStyle="bold" />
        <TextView android:id="@+id/dish_description" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="@color/group_buy_muted" android:textSize="11sp" />
        <TextView android:id="@+id/dish_price" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/group_buy_orange" android:textSize="19sp" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
