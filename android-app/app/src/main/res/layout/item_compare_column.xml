<?xml version="1.0" encoding="utf-8"?>
<!-- Compare/Column逐字段来自当前API；未知保留文字，禁止通过标题推断人数或内容。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="170dp" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp" android:background="@drawable/compare_column">
<ImageView android:id="@+id/compare_photo" android:layout_width="match_parent" android:layout_height="66dp" android:scaleType="centerCrop" android:background="@drawable/compare_photo" android:clipToOutline="true" />
<TextView android:id="@+id/compare_title" style="@style/CompareText" android:layout_marginTop="8dp" />
<TextView android:id="@+id/compare_store" style="@style/CompareCaption" android:layout_marginTop="8dp" />
<TextView android:id="@+id/compare_price" style="@style/CompareText" android:textSize="24sp" android:textStyle="bold" android:textColor="@color/group_buy_orange" android:layout_marginTop="8dp" /><TextView style="@style/CompareCaption" android:text="原价" android:layout_marginTop="8dp" /><TextView android:id="@+id/compare_original" style="@style/CompareText" android:layout_marginTop="2dp" /><TextView style="@style/CompareCaption" android:text="人数与人均" android:layout_marginTop="8dp" /><TextView android:id="@+id/compare_people" style="@style/CompareText" android:layout_marginTop="2dp" /><TextView style="@style/CompareCaption" android:text="内容" android:layout_marginTop="8dp" /><TextView android:id="@+id/compare_contents" style="@style/CompareText" android:layout_marginTop="2dp" /><TextView style="@style/CompareCaption" android:text="有效期" android:layout_marginTop="8dp" /><TextView android:id="@+id/compare_validity" style="@style/CompareText" android:layout_marginTop="2dp" /><TextView style="@style/CompareCaption" android:text="适用门店" android:layout_marginTop="8dp" /><TextView android:id="@+id/compare_applicable" style="@style/CompareText" android:layout_marginTop="2dp" /><TextView style="@style/CompareCaption" android:text="使用规则" android:layout_marginTop="8dp" /><TextView android:id="@+id/compare_rules" style="@style/CompareText" android:layout_marginTop="2dp" /><TextView android:id="@+id/compare_column_status" style="@style/CompareCaption" android:textColor="@color/group_buy_green" android:layout_marginTop="8dp" />
<TextView android:id="@+id/compare_column_retry" style="@style/CompareButton" android:text="重试读取" android:layout_marginTop="8dp" android:visibility="gone" />
</LinearLayout>
