<?xml version="1.0" encoding="utf-8"?>
<!-- 门店页面 UI-03/UI-04/UI-05：一个页面容器切换优惠、菜品、评价三种内容状态。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/group_buy_background" android:orientation="vertical">
    <!-- 沿用整屏状态栏背景，内容留出顶部安全区域；封面/返回不能遮住系统状态图标。 -->
    <FrameLayout android:layout_width="match_parent" android:layout_height="171dp" android:paddingTop="24dp" android:background="@color/group_buy_green">
        <ImageButton android:id="@+id/store_back" android:layout_width="44dp" android:layout_height="44dp" android:layout_marginStart="4dp" android:layout_marginTop="20dp" android:background="@android:color/transparent" android:contentDescription="返回" android:padding="10dp" android:src="@drawable/ic_back" app:tint="@color/surface_card" />
        <!-- 头部只保留区域，业务图片与文案全部等待当前门店 API 绑定。 -->
        <ImageView android:id="@+id/store_cover" android:layout_width="150dp" android:layout_height="102dp" android:layout_gravity="end|top" android:layout_marginTop="20dp" android:layout_marginEnd="12dp" android:contentDescription="门店图片加载中" android:scaleType="centerCrop" />
        <TextView android:id="@+id/store_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_marginEnd="172dp" android:layout_marginTop="66dp" android:ellipsize="end" android:maxLines="2" android:text="正在加载门店" android:textColor="@color/surface_card" android:textSize="20sp" android:textStyle="bold" />
        <TextView android:id="@+id/store_meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_marginEnd="172dp" android:layout_marginTop="115dp" android:ellipsize="end" android:maxLines="1" android:textColor="@color/group_buy_orange" android:textSize="11sp" />
    </FrameLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:background="@color/surface_card" android:gravity="center" android:orientation="horizontal">
        <TextView android:id="@+id/store_tab_deals" style="@style/StoreContentTab" android:text="优惠" />
        <TextView android:id="@+id/store_tab_dishes" style="@style/StoreContentTab" android:text="菜品" />
        <TextView android:id="@+id/store_tab_reviews" style="@style/StoreContentTab" android:text="评价" />
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:paddingStart="12dp" android:paddingTop="10dp" android:paddingEnd="12dp" android:paddingBottom="16dp">
        <LinearLayout android:id="@+id/store_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
    </ScrollView>
</LinearLayout>
