<?xml version="1.0" encoding="utf-8"?>
<!-- UI-15A 可编辑空态：品牌头像与三个既定快捷输入，不包含任何业务样例。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/agent_chat_empty_state" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:gravity="center_horizontal" android:paddingTop="64dp" android:paddingBottom="32dp">
    <TextView android:layout_width="104dp" android:layout_height="104dp" android:background="@drawable/agent_chat_empty_avatar"
        android:text="AI" android:gravity="center" android:textSize="27sp" android:textStyle="bold" android:textColor="@color/group_buy_orange" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="34dp"
        android:gravity="center" android:text="你好，我是饭搭子" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/group_buy_green" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"
        android:gravity="center" android:text="可以帮你找餐厅、选团购和查看订单" android:textSize="14sp" android:textColor="@color/group_buy_muted" />
    <TextView android:id="@+id/agent_quick_nearby" android:layout_width="match_parent" android:layout_height="38dp"
        android:layout_marginHorizontal="16dp" android:layout_marginTop="52dp" android:background="@drawable/agent_chat_input_background"
        android:gravity="center" android:text="附近有什么好吃的？" android:textSize="14sp" android:textColor="@color/group_buy_text" />
    <TextView android:id="@+id/agent_quick_deal" android:layout_width="match_parent" android:layout_height="38dp"
        android:layout_marginHorizontal="16dp" android:layout_marginTop="14dp" android:background="@drawable/agent_chat_input_background"
        android:gravity="center" android:text="帮我找性价比高的团购" android:textSize="14sp" android:textColor="@color/group_buy_text" />
    <TextView android:id="@+id/agent_quick_order" android:layout_width="match_parent" android:layout_height="38dp"
        android:layout_marginHorizontal="16dp" android:layout_marginTop="14dp" android:background="@drawable/agent_chat_input_background"
        android:gravity="center" android:text="查看我的订单" android:textSize="14sp" android:textColor="@color/group_buy_text" />
</LinearLayout>
