<?xml version="1.0" encoding="utf-8"?>
<!-- 空态/登录共享头像、标题、说明和三个动作槽；登录隐藏头像及第三槽，前两槽重新绑定原动作。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/agent_chat_empty_state" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:gravity="center_horizontal" android:paddingTop="64dp" android:paddingBottom="32dp">
    <TextView android:id="@+id/agent_reusable_guide_avatar" android:layout_width="104dp" android:layout_height="104dp"
        android:background="@drawable/agent_chat_empty_avatar" android:text="AI" android:gravity="center" android:textSize="27sp"
        android:textStyle="bold" android:textColor="@color/group_buy_orange" />
    <TextView android:id="@+id/agent_reusable_guide_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="34dp" android:gravity="center" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/group_buy_green" />
    <TextView android:id="@+id/agent_reusable_guide_body" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:gravity="center" android:textSize="14sp" android:textColor="@color/group_buy_muted" />
    <TextView android:id="@+id/agent_quick_nearby" android:layout_width="match_parent" android:layout_height="38dp"
        android:layout_marginHorizontal="16dp" android:layout_marginTop="52dp" android:background="@drawable/agent_chat_input_background"
        android:gravity="center" android:textSize="14sp" android:textColor="@color/group_buy_text" />
    <TextView android:id="@+id/agent_quick_deal" android:layout_width="match_parent" android:layout_height="38dp"
        android:layout_marginHorizontal="16dp" android:layout_marginTop="14dp" android:background="@drawable/agent_chat_input_background"
        android:gravity="center" android:textSize="14sp" android:textColor="@color/group_buy_text" />
    <TextView android:id="@+id/agent_quick_order" android:layout_width="match_parent" android:layout_height="38dp"
        android:layout_marginHorizontal="16dp" android:layout_marginTop="14dp" android:background="@drawable/agent_chat_input_background"
        android:gravity="center" android:textSize="14sp" android:textColor="@color/group_buy_text" />
</LinearLayout>
