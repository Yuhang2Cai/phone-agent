<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/merchant_card" android:layout_width="match_parent" android:layout_height="124dp" android:layout_marginBottom="8dp" android:background="@drawable/search_merchant_card" android:clickable="true" android:focusable="true">
    <ImageView android:id="@+id/merchant_cover" android:layout_width="112dp" android:layout_height="108dp" android:layout_gravity="start|center_vertical" android:layout_marginStart="7dp" android:contentDescription="商家封面" android:scaleType="centerCrop" android:src="@drawable/merchant_cover_placeholder" />
    <TextView android:id="@+id/merchant_name" android:layout_width="190dp" android:layout_height="wrap_content" android:layout_marginStart="130dp" android:layout_marginTop="8dp" android:ellipsize="end" android:maxLines="1" android:textColor="@color/brand_ink" android:textSize="15sp" android:textStyle="bold" />
    <TextView android:id="@+id/merchant_distance" android:layout_width="wrap_content" android:layout_height="22dp" android:layout_gravity="end" android:layout_marginTop="7dp" android:layout_marginEnd="8dp" android:background="@drawable/home_distance_background" android:gravity="center" android:paddingStart="7dp" android:paddingEnd="7dp" android:textColor="@color/success_green" android:textSize="10sp" />
    <TextView android:id="@+id/merchant_meta" android:layout_width="250dp" android:layout_height="wrap_content" android:layout_marginStart="130dp" android:layout_marginTop="34dp" android:ellipsize="end" android:maxLines="1" android:textColor="@color/brand_muted" android:textSize="10sp" />
    <TextView android:id="@+id/merchant_tags" android:layout_width="250dp" android:layout_height="wrap_content" android:layout_marginStart="130dp" android:layout_marginTop="55dp" android:ellipsize="end" android:maxLines="1" android:textColor="@color/brand_orange" android:textSize="10sp" />
    <TextView android:id="@+id/merchant_price" android:layout_width="170dp" android:layout_height="wrap_content" android:layout_marginStart="130dp" android:layout_marginTop="79dp" android:ellipsize="end" android:maxLines="1" android:textColor="@color/brand_orange" android:textSize="13sp" android:textStyle="bold" />
    <TextView android:id="@+id/merchant_description" android:layout_width="210dp" android:layout_height="wrap_content" android:layout_marginStart="130dp" android:layout_marginTop="101dp" android:ellipsize="end" android:maxLines="1" android:textColor="@color/brand_muted" android:textSize="9sp" />
    <TextView android:id="@+id/merchant_order" android:layout_width="68dp" android:layout_height="36dp" android:layout_gravity="end|bottom" android:layout_marginEnd="10dp" android:layout_marginBottom="10dp" android:background="@drawable/search_button_background" android:contentDescription="查看商家菜单" android:gravity="center" android:text="去下单" android:textColor="@color/surface_card" android:textSize="12sp" android:textStyle="bold" />
</FrameLayout>
