<?xml version="1.0" encoding="utf-8"?>
<!-- 秒杀用户端确认稿原生布局；业务文字和状态由服务器快照绑定。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/sk_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="12dp" android:background="@drawable/sk_bg_white" android:layout_marginTop="16dp">
    <FrameLayout android:layout_width="76dp" android:layout_height="76dp">
        <include layout="@layout/include_seckill_photo"/>
    </FrameLayout>
    <LinearLayout android:id="@+id/sk_summary_copy" android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="12dp" android:layout_weight="1">
        <TextView android:id="@+id/sk_summary_title" style="@style/SkText" android:textStyle="bold" android:textSize="16sp"/>
        <TextView android:id="@+id/sk_summary_caption" style="@style/SkMuted" android:layout_marginTop="5dp"/>
        <!-- 当前报价摘要保留确认稿的秒杀价与划线原价；已下单时由绑定层隐藏没有历史快照的原价。 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="8dp">
            <TextView android:id="@+id/sk_summary_price" style="@style/SkTitle" android:layout_width="wrap_content" android:textSize="24sp" android:textColor="@color/group_buy_orange"/>
            <TextView android:id="@+id/sk_summary_original" style="@style/SkMuted" android:layout_width="wrap_content" android:layout_marginStart="12dp" android:textSize="12sp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
