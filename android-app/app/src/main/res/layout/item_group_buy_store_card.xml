<?xml version="1.0" encoding="utf-8"?>
<!-- 首页和搜索结果共用的门店卡片，不包含配送、起送价或购物车字段。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="124dp" android:layout_marginBottom="8dp" android:background="@drawable/group_buy_card_background" android:clickable="true" android:elevation="2dp" android:focusable="true" android:orientation="horizontal">
    <ImageView android:id="@+id/store_image" android:layout_width="130dp" android:layout_height="match_parent" android:contentDescription="门店图片" android:scaleType="centerCrop" />
    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:paddingStart="10dp" android:paddingTop="9dp" android:paddingEnd="9dp" android:paddingBottom="8dp">
        <TextView android:id="@+id/store_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="@color/group_buy_text" android:textSize="17sp" android:textStyle="bold" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/store_rating" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/group_buy_orange" android:textSize="13sp" android:textStyle="bold" />
            <TextView android:id="@+id/store_reviews" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:textColor="@color/group_buy_muted" android:textSize="11sp" />
            <TextView android:id="@+id/store_distance" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/group_buy_muted" android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="7dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:id="@+id/deal_image" android:layout_width="48dp" android:layout_height="42dp" android:contentDescription="套餐图片" android:scaleType="centerCrop" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/deal_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="@color/group_buy_text" android:textSize="12sp" android:textStyle="bold" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:id="@+id/deal_price" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/group_buy_orange" android:textSize="18sp" android:textStyle="bold" />
                    <TextView android:id="@+id/deal_original_price" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:textColor="@color/group_buy_muted" android:textSize="10sp" />
                    <TextView android:id="@+id/deal_discount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:background="@drawable/group_buy_discount_background" android:paddingStart="5dp" android:paddingTop="2dp" android:paddingEnd="5dp" android:paddingBottom="2dp" android:textColor="@color/group_buy_orange" android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
